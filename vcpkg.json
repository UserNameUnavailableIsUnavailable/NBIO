{
  "name": "NBIO",
  "version": "1.0.0",
  "license": "MIT",
  "dependencies": [
    "tl-expected"
  ],
  "features": {
    "io-uring": {
      "description": "Enable the Linux io_uring multiplexer",
      "dependencies": [
        {
          "platform": "linux",
          "name": "liburing"
        }
      ]
    },
    "rdma": {
      "description": "Enable Linux RDMA support; requires system librdmacm and libibverbs development packages"
    },
    "custom-memory-pooling": {
      "description": "Enable NBIO's Linux global allocation pool",
      "supports": "linux"
    },
    "testing": {
      "description": "Build the test suite",
      "dependencies": [ "gtest" ]
    },
    "benchmark": {
      "description": "Build the benchmark suite",
      "dependencies": [ "benchmark", "cli11" ]
    }
  }
}